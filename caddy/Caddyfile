{
    admin :2019
}

(logs) {
    log {
        output stdout
        format json
    }
}


# Snippet commun PHP (FPM)
(php_stack) {
        php_fastcgi php:{$PHP_INTERNAL_PORT}
        file_server
}

# Snippet commun SSO AUTH
(sso_auth_forward) {
        forward_auth http://authelia:9091 {
            uri /api/verify?rd=https://auth.{$DOMAIN}
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
}

# ===== Racine du domaine : LANDING à la racine =====
{$DOMAIN} {
        import logs
        root * {$LANDING_ROOT}
        import php_stack
}

# Optionnel : www.domaine
www.{$DOMAIN} {
        import logs
        root * {$LANDING_ROOT}
        import php_stack
}

# ===== SSO Authelia =====
{$SUBDOMAIN_AUTH}.{$DOMAIN} {
        import logs
        reverse_proxy authelia:9091
}

# ===== Sous-domaines PHP =====
{$SUBDOMAIN_HTML}.{$DOMAIN} {
        import logs
        root * {$HTML_ROOT}
        import php_stack
}

{$SUBDOMAIN_PHP}.{$DOMAIN} {
        import logs
        root * {$PHP_SIMPLE_ROOT}
        import php_stack
}

{$SUBDOMAIN_LARAVEL}.{$DOMAIN} {
        import logs
        root * {$LARAVEL_ROOT}
        import php_stack
}

{$SUBDOMAIN_SYMFONY}.{$DOMAIN} {
        import logs
        root * {$SYMFONY_ROOT}
        import php_stack
        import sso_auth_forward
}

{$SUBDOMAIN_WORDPRESS}.{$DOMAIN} {
        import logs
        root * {$WORDPRESS_ROOT}
        import php_stack
        import sso_auth_forward
}

# ===== Services externes =====
{$SUBDOMAIN_PHPMYADMIN}.{$DOMAIN} {
        import logs
        reverse_proxy phpmyadmin:80
}

{$SUBDOMAIN_GO}.{$DOMAIN} {
        import logs
        reverse_proxy go:{$GO_INTERNAL_PORT}
        import sso_auth_forward
}

{$SUBDOMAIN_DJANGO}.{$DOMAIN} {
        import logs
        reverse_proxy django:{$DJANGO_INTERNAL_PORT}
        import sso_auth_forward
}


{$SUBDOMAIN_NODE}.{$DOMAIN} {
        import logs
        reverse_proxy node:{$NODE_INTERNAL_PORT}
        import sso_auth_forward
}

# ===== Monitoring (Grafana) =====
{$SUBDOMAIN_GRAFANA}.{$DOMAIN} {
    import logs
    import sso_auth_forward
    reverse_proxy grafana:3000 # On cible le port interne du conteneur
}
